  "mainContent" : "<div class=\"sqs-layout sqs-grid-12 columns-12\" data-type=\"page\" data-updated-on=\"1512922709657\" id=\"page-5787540f893fc0cdcce128ac\"><div class=\"row sqs-row\"><div class=\"col sqs-col-12 span-12\"><div class=\"sqs-block website-component-block sqs-block-website-component sqs-block-spacer spacer-block sized vsize-1\" data-block-css=\"[&quot;https://definitions.sqspcdn.com/website-component-definition/static-assets/website.components.spacer/7fd9496e-a333-4843-a512-848194c635d1_1162/website.components.spacer.styles.css&quot;]\" data-block-scripts=\"[&quot;https://definitions.sqspcdn.com/website-component-definition/static-assets/website.components.spacer/7fd9496e-a333-4843-a512-848194c635d1_1162/website.components.spacer.visitor.js&quot;]\" data-block-type=\"1337\" data-definition-name=\"website.components.spacer\" data-website-component-id=\"yui_3_17_2_72_1512892624651_3799\" id=\"block-yui_3_17_2_72_1512892624651_3799\"><div class=\"sqs-block-content\">&nbsp;</div></div><div class=\"sqs-block html-block sqs-block-html\" data-block-type=\"2\" data-sqsp-block=\"text\" id=\"block-5787540f893fc0cdcce128ad\"><div class=\"sqs-block-content\">\n\n<div class=\"sqs-html-content\" data-sqsp-text-block-content>\n  <h2>Acknowledgements</h2><h3>The MacMillan Estate would like to thank:</h3><ul><li>&nbsp; &nbsp; &nbsp; &nbsp;Brendan McCarthy for his extraordinarily detailed research for this website, his time and enthusiasm.</li><li><p style=\"margin-left:40px\">Myra Armstrong, American Ballet Theatre</p></li><li><p style=\"margin-left:40px\">Alex Batterbee, The Royal Opera House</p></li><li><p style=\"margin-left:40px\">Melvyn Bragg, The South Bank Show, ITV&nbsp;</p></li><li><p style=\"margin-left:40px\">Revinder Chahal, The Victoria &amp; Albert Museum</p></li><li><p style=\"margin-left:40px\">Ted Chapin, Rodgers and Hammerstein Organisation</p></li><li><p style=\"margin-left:40px\">Julia Creed, Royal Opera House Collections</p></li><li><p style=\"marg